@page "/customers"
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<h2>Все клиенты</h2>

<div class="card">
    <DataGrid Items="Customers" TItem="CustomerItem">
        <HeaderRow>
            <th>Имя</th><th>Телефон</th><th>Статус</th><th>Потрачено</th><th>Баллы</th>
        </HeaderRow>
        <RowTemplate Context="c">
            <td>@c.FullName</td>
            <td>@c.Phone</td>
            <td>@c.Status</td>
            <td>@c.TotalSpent.ToString("N0") TJS</td>
            <td>@c.LoyaltyPoints</td>
        </RowTemplate>
    </DataGrid>
</div>

@code {
    private List<CustomerItem> Customers = new();

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CurrentUser is null) { Nav.NavigateTo("/login"); return; }
        var result = await Api.GetAsync<PagedResult<CustomerItem>>("admin/customers?limit=100");
        Customers = result?.Items ?? new();
    }
}
