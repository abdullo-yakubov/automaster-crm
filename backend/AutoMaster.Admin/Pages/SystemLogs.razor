@page "/logs"
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<h2>Системные логи (Audit Log)</h2>

<div class="card">
    <DataGrid Items="Logs" TItem="AuditLogItem">
        <HeaderRow>
            <th>Время</th><th>Пользователь</th><th>Действие</th><th>Объект</th><th>Детали</th>
        </HeaderRow>
        <RowTemplate Context="l">
            <td>@l.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@l.UserName</td>
            <td>@l.Action</td>
            <td>@l.ObjectType #@l.ObjectId</td>
            <td>@l.Details</td>
        </RowTemplate>
    </DataGrid>
</div>

@code {
    private List<AuditLogItem> Logs = new();

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CurrentUser is null) { Nav.NavigateTo("/login"); return; }
        Logs = await Api.GetAsync<List<AuditLogItem>>("audit/logs") ?? new();
    }
}
